# Copy to .env and adjust. Used by docker compose (server reads the same values).
# For local dev without Docker, the server falls back to the defaults shown here.

# --- Host ports ---
SERVER_PORT=4000
CLIENT_PORT=3000

# --- Server ---
PORT=4000
REDIS_URL=redis://localhost:6379
DATA_DIR=./data
FILE_TTL_MINUTES=60
MAX_FILE_SIZE_MB=100
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info
WORKER_CONCURRENCY=2

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CONVERT_RATE_LIMIT_MAX=30
SELFTEST_RATE_LIMIT_MAX=10

# --- Client (baked in at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADSENSE_CLIENT=
